# Copy to .env and `set -a; source .env; set +a` (or export manually).
JIRA_BASE_URL=https://openmrs.atlassian.net
# Bot account credentials. Leave blank for anonymous read-only dry-runs.
JIRA_EMAIL=
JIRA_API_TOKEN=
# The bot's Atlassian accountId - used to attribute changelog entries
# (opt-out detection) and to exclude the bot's own comments from contexts.
TRIAGE_BOT_ACCOUNT_ID=
# Claude API key. If unset, the SDK falls back to an `ant auth login` profile.
ANTHROPIC_API_KEY=
