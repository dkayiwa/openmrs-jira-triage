# Copy to .env - it is gitignored and auto-loaded by every triage command.
JIRA_BASE_URL=https://openmrs.atlassian.net
# Bot account credentials. Leave blank for anonymous read-only dry-runs.
JIRA_EMAIL=
JIRA_API_TOKEN=
# The bot's Atlassian accountId - used to attribute changelog entries
# (opt-out detection) and to exclude the bot's own comments from contexts.
TRIAGE_BOT_ACCOUNT_ID=
# Claude API key. If unset, the SDK falls back to an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Optional, read-only, public data only: raises the GitHub search limit used by
# the open-PR backstop from 10 to 30 searches/min. GITHUB_TOKEN=$(gh auth token)
# works locally. Without it a full-cohort sweep spends ~6s per ticket waiting.
GITHUB_TOKEN=
